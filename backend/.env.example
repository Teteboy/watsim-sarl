# Local development template. Copy to .env and replace all secret placeholders.
# Generate URL-safe DB/Redis passwords with openssl rand -hex 32.
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX_PASSWORD
# Keep URL passwords identical to the values above. Compose overrides hostnames.
DATABASE_URL=postgresql://watsim:REPLACE_WITH_RANDOM_HEX_PASSWORD@127.0.0.1:5432/watsim_db?schema=public
REDIS_URL=redis://:REPLACE_WITH_DIFFERENT_RANDOM_HEX_PASSWORD@127.0.0.1:6379
UPLOADS_DIR=uploads
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
LOG_LEVEL=debug
TIMEZONE=Africa/Douala
USE_MOCK_PAYMENTS=true
USE_CAMPAY=false
# Demo for development. Production MUST explicitly use https://www.campay.net.
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_PERMENENT_ACCESS_TOKEN=
CAMPAY_WEBHOOK_KEY=
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
USE_SMILE_ID=false
SMILE_ID_BASE_URL=https://api.smileidentity.com
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_CALLBACK_URL=http://localhost:3001/api/v1/auth/kyc/webhook/smile-id
