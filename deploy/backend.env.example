# =============================================
# WATSIM Backend — Production Environment
# Copy this to /var/www/watsim/backend/.env
# Fill in ALL values before starting the server
# =============================================

NODE_ENV=production
PORT=3001
API_PREFIX=/api/v1
FRONTEND_URL=https://YOUR_DOMAIN
BACKEND_URL=https://YOUR_DOMAIN

# PostgreSQL (replace with your DB credentials)
DATABASE_URL=postgresql://watsim_user:STRONG_PASSWORD@localhost:5432/watsim_db

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT secrets — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Logging
LOG_LEVEL=info
TIMEZONE=Africa/Douala

# ---- Payment Providers ----
USE_MOCK_PAYMENTS=false

# CamPay (preferred)
USE_CAMPAY=true
CAMPAY_BASE_URL=https://www.campay.net
CAMPAY_USERNAME=YOUR_CAMPAY_USERNAME
CAMPAY_PASSWORD=YOUR_CAMPAY_PASSWORD
CAMPAY_PERMENENT_ACCESS_TOKEN=YOUR_CAMPAY_TOKEN
CAMPAY_WEBHOOK_KEY=YOUR_CAMPAY_WEBHOOK_KEY

# Orange Money (direct)
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_MERCHANT_KEY=YOUR_OM_KEY
ORANGE_MONEY_WEBHOOK_SECRET=YOUR_OM_WEBHOOK_SECRET

# MTN MoMo (direct)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=YOUR_MTN_KEY
MTN_MOMO_API_USER=YOUR_MTN_API_USER
MTN_MOMO_API_KEY=YOUR_MTN_API_KEY
MTN_MOMO_WEBHOOK_SECRET=YOUR_MTN_WEBHOOK_SECRET

# ---- Twilio SMS/OTP ----
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ---- Smile ID KYC ----
USE_SMILE_ID=false
SMILE_ID_BASE_URL=https://api.smileidentity.com
SMILE_ID_PARTNER_ID=YOUR_PARTNER_ID
SMILE_ID_API_KEY=YOUR_API_KEY
SMILE_ID_CALLBACK_URL=https://YOUR_DOMAIN/api/v1/kyc/callback
